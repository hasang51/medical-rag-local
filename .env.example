MEDICAL_RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEDICAL_RAG_MODEL=gemma4:e4b
MEDICAL_RAG_NUM_CTX=2048
# Gemma 4 genel sohbet önerisi 1.0'dır. RAG için bilinçli sapma: 0.2
MEDICAL_RAG_TEMPERATURE=0.2
MEDICAL_RAG_NUM_PREDICT=128
# Karşılaştırma turu: MEDICAL_RAG_NUM_PREDICT=512 ve MEDICAL_RAG_THINK=true
MEDICAL_RAG_THINK=false
MEDICAL_RAG_REQUEST_TIMEOUT_SECONDS=180
MEDICAL_RAG_BM25_SCORE_THRESHOLD=1.0
